import csv
import re

input_file = "movies.csv"

movies = []

with open(input_file, "r", newline="", encoding="utf-8") as file:
    reader = csv.DictReader(file)

    for row in reader:
        movies.append(row)

print("Movie Records:")

for movie in movies:
    print(movie)

movie_id = input("\nEnter Movie ID to search: ")

found = False

for movie in movies:
    if movie["Movie ID"] == movie_id:
        print("\nMovie Found:")
        print("Movie ID:", movie["Movie ID"])
        print("Title:", movie["Title"])
        print("Year:", movie["Year"])
        found = True
        break

if found == False:
    print("Movie not found.")

title = input("\nEnter movie title to search: ")

pattern = re.compile(title, re.IGNORECASE)

print("\nMovies matching the title:")

found = False

for movie in movies:
    if pattern.search(movie["Title"]):
        print(movie)
        found = True

if found == False:
    print("No movie found with this title.")




